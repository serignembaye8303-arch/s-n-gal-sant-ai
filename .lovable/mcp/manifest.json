              "enum": [
                "admin",
                "specialiste",
                "agent"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_ai_diagnostics",
        "title": "List AI diagnostics",
        "description": "List recent AI diagnostic log entries visible to the signed-in user (RLS-scoped). Returns id, created_at and payload metadata.",
